# ====================================================================
# TOKEN-OS: Environment Variables Template (.env.example)
# Copy this file to `.env` and fill in your own project credentials.
# Never commit `.env` or live secrets to Git.
# ====================================================================

# 1. Supabase Cloud PostgreSQL & Auth
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# 2. OAuth Provider Reference Credentials (Paste into Supabase Dashboard -> Auth -> Providers)
# Callback URI for both Google & GitHub: https://<your-project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# 3. AI Provider Keys (Frontend Vite + Local Vault Seed)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash
VITE_OPENROUTER_API_KEY=
VITE_GROQ_API_KEY=

# 4. Server-Side / Optional AI Model Keys (Not exposed to browser bundle)
GROQ_API_KEY=
XAI_GROK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 5. Local Services & ML Backend Endpoints
OLLAMA_BASE_URL=http://localhost:11434
VITE_ML_SERVICE_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000

# 6. Runtime Environment
NODE_ENV=development
TOKENOS_ENV=development
